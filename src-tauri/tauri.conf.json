{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YiziVoice",
  "version": "2.1.4",
  "identifier": "com.yizivoice.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "YiziVoice",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "backgroundColor": "#E8F4FD",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.xiaomimimo.com data: blob:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/YiziVoice/History/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../default-config/voices/**/*.json": "default-config/voices/",
      "../default-config/styles/**/*.json": "default-config/styles/",
      "../default-config/audio-tags/**/*.json": "default-config/audio-tags/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "deb/main.desktop",
        "postInstallScript": "deb/postinst"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwRDk3NjkwN0Y0MUE2MTAKUldRUXBrRi9rSGJaRUEveUc4VW44R01MekVxZVMrZGJQMGVCd1BDdkMyNkZ3S2dodzdGcWVOZjIK",
      "endpoints": [
        "https://github.com/laoduu/YiziVoice/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
